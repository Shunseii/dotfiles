# herdr-auto-title settings. Read once at startup:
#   herdr plugin action invoke herdr.auto-title.restart
# Tab label is just the agent session name (/rename, claude -n, pi /name).
HERDR_AUTO_TITLE_POSITION=false
HERDR_AUTO_TITLE_BRANCH_MAX=0
HERDR_AUTO_TITLE_DIRECTORY_MAX=0
HERDR_AUTO_TITLE_PREFER_AGENT=true
HERDR_AUTO_TITLE_PANES=false
